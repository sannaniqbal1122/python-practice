        "# PCA\n",
        "pca = PCA(n_components=2)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "\n",
        "df['PCA1'] = X_pca[:,0]\n",
        "df['PCA2'] = X_pca[:,1]\n",
        "\n",
        "print(\"Explained Variance Ratio:\", pca.explained_variance_ratio_)"
