        "# Program: Student grades dictionary with a function to add new students\n",
        "\n",
        "students = {\n",
        "    \"Ali\": \"A\",\n",
        "    \"Sara\": \"B\",\n",
        "    \"Usman\": \"A-\"\n",
        "}\n",
        "\n",
        "def add_student(records, name, grade):\n",
        "    \"\"\"Add a new student and grade to the dictionary.\"\"\"\n",
        "    if name in records:\n",
        "        print(f\"{name} already exists. Use a different name.\")\n",
        "    else:\n",
        "        records[name] = grade\n",
        "        print(f\"{name} added successfully.\")\n",
        "\n",
        "# Accept new student data from the user\n",
        "name = input(\"Enter student name: \")\n",
        "grade = input(\"Enter grade: \")\n",
        "\n",
        "add_student(students, name, grade)\n",
        "\n",
        "# Display all records\n",
        "print(\"\\nStudent Records:\")\n",
        "for student, g in students.items():\n",
        "    print(f\"{student}: {g}\")"
